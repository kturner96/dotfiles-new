{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/hyperpager"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery", "tray"],


    "custom/hyperpager": {
    "exec": "/home/keiran//dev/projects/hyperpager/hyperpager",
    "restart-interval": 5
},

    "clock": {
        "format": "{:%H:%M %d/%m/%Y}"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "ETH",
        "format-disconnected": "No Network"
    },
    "pulseaudio": {
        "format": "{volume}%"
    }
}
