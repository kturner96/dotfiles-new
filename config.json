{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["wlr/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery", "tray"],

    "wlr/workspaces": {
    	"format": "{id}",
    	"persistent-workspaces": {
        "*": 5
    			}
		},
    "clock": {
        "format": "{:%H:%M %d/%m/%Y}"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "ETH",
        "format-disconnected": "No Network"
    },
    "pulseaudio": {
        "format": "{volume}%"
    }
}
